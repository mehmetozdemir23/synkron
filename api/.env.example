APP_NAME=Synkron
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Used for OAuth callback redirects
APP_FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Sanctum Configuration
# En production, définir le domaine frontend (ex: app.synkron.com)
SANCTUM_STATEFUL_DOMAINS=localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Configuration
# Test keys: https://dashboard.stripe.com/test/apikeys
# Production keys: https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx

# Stripe Price IDs
# Créer les produits et récupérer les Price IDs depuis https://dashboard.stripe.com/test/products
# Pour le plan gratuit, laisser vide
STRIPE_PRICE_MONTHLY=price_xxx_monthly
STRIPE_PRICE_YEARLY=price_xxx_yearly

# Stripe Webhooks
# Créer un webhook endpoint dans https://dashboard.stripe.com/test/webhooks
# URL du webhook: https://votredomaine.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google OAuth Configuration
# Créer une application Google Cloud Console (https://console.cloud.google.com)
# 1. Créer un projet
# 2. Activer Google+ API
# 3. Créer une Credential OAuth 2.0 (Type: Application Web)
# 4. Ajouter les URIs autorisés de redirection:
#    - http://localhost:8000/auth/google/callback (development)
#    - https://api.synkron.app/auth/google/callback (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback
