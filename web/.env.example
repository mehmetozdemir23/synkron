# API Configuration
# URL de l'API backend Laravel
# Development: http://localhost:8000/api
# Production: https://api.votredomaine.com/api
VITE_API_URL=http://localhost:8000/api

# Application Configuration
# Nom de l'application
VITE_APP_NAME=Synkron

# Environment
# Valeurs possibles: development, production
VITE_ENV=development

# Google OAuth Configuration
# Google Client ID pour l'authentification OAuth
# Obtenir depuis Google Cloud Console: https://console.cloud.google.com
# 1. Créer un projet
# 2. Activer Google+ API
# 3. Créer une Credential OAuth 2.0 (Type: Application Web)
# 4. Copier le Client ID (exemple: 123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
